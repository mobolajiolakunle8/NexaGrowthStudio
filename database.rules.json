{
  "rules": {
    "nexa": {
      "v2": {
        "catalog": {
          ".read": true,
          ".write": true
        },
        "leads": {
          ".read": true,
          "$leadId": {
            ".write": true,
            ".validate": "newData.hasChildren(['id', 'bookId', 'name', 'email', 'phone', 'date', 'status']) || !newData.exists()"
          }
        },
        "$other": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
