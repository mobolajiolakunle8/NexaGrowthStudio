rules_version = '2';

// Public read so visitors can download the book from the link.
// Write is limited to files under 25MB (admin uploads only).
service firebase.storage {
  match /b/{bucket}/o {
    match /books/{bookId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }
  }
}
